extends layout

block content
  // Modern Hero Landing Page with 3D Effects
extends layout

block content
  // Ultra Master Landing Page - World-Class Visual Experience
  .landing-wrapper.ultra-hero-bg.ultra-hero-master.min-h-screen.relative.overflow-hidden
    
    // Advanced Particle System
    .particles-container.absolute.inset-0.pointer-events-none(style="z-index: 1;")
      
    // Floating Geometric Shapes with Ultra Effects
    .shapes-container.absolute.inset-0.pointer-events-none(style="z-index: 2;")
      // Large gradient orbs
      .floating-shape.ultra-particle.absolute.w-96.h-96.rounded-full.animate-float(
        style="top: 10%; left: -10%; background: radial-gradient(circle, rgba(59, 130, 246, 0.1), transparent); animation-duration: 20s;"
      )
      .floating-shape.ultra-particle.absolute.w-80.h-80.rounded-full.animate-float-delayed(
        style="top: 60%; right: -5%; background: radial-gradient(circle, rgba(139, 92, 246, 0.08), transparent); animation-duration: 25s;"
      )
      .floating-shape.ultra-particle.absolute.w-64.h-64.rounded-full.animate-bounce-slow(
        style="top: 30%; right: 20%; background: radial-gradient(circle, rgba(236, 72, 153, 0.06), transparent); animation-duration: 18s;"
      )    // Main Hero Content
    section.hero.relative.z-10.min-h-screen.flex.items-center.justify-center.px-4
      .container.mx-auto.max-w-7xl
        .grid.gap-16.items-center.text-center(class="lg:grid-cols-2 lg:text-left")
          
          // Left Content - Main Message
          .hero-content.space-y-8
            // Badge
            .inline-flex.items-center.px-4.py-2.rounded-full.bg-white.bg-opacity-10.backdrop-blur-sm.border.border-white.border-opacity-20.text-white.text-sm.font-medium.mb-6
              ✨ Nowość 2025
              .ml-2.w-2.h-2.bg-green-400.rounded-full.animate-pulse
            
            // Main Heading
            h1.hero-title.ultra-title.ultra-title-master.text-5xl.font-black.leading-tight.mb-6(
              class="md:text-7xl lg:text-8xl"
              data-text="SignumLBRI"
            )
              .text-white.mb-2 SignumLBRI
              .bg-gradient-to-r.from-blue-400.via-purple-400.to-pink-400.bg-clip-text.text-transparent.animate-gradient
                | Marketplace Marzeń
            
            // Subtitle
            p.hero-subtitle.ultra-subtitle.text-xl.leading-relaxed.max-w-2xl.mb-8(class="lg:text-2xl")
              | 🎯 Sprzedawaj i kupuj książki szkolne w 
              strong.text-white najnowocześniejszej platformie 
              | edukacyjnej w Polsce!
            
            // Stats
            .stats-container.grid.grid-cols-3.gap-6.mb-8.max-w-md.mx-auto(class="lg:mx-0")
              .stat-item.ultra-stat.ultra-glass-master.text-center.p-4.rounded-2xl
                .stat-number.ultra-stat-number.text-3xl.font-bold.mb-1 2500+
                .stat-label.text-sm.text-blue-200 Użytkowników
              .stat-item.ultra-stat.ultra-glass-master.text-center.p-4.rounded-2xl
                .stat-number.ultra-stat-number.text-3xl.font-bold.mb-1 15k+
                .stat-label.text-sm.text-blue-200 Książek
              .stat-item.ultra-stat.ultra-glass-master.text-center.p-4.rounded-2xl
                .stat-number.ultra-stat-number.text-3xl.font-bold.mb-1 98%
                .stat-label.text-sm.text-blue-200 Zadowolenia
            
            // CTA Buttons
            .cta-container.flex.flex-col.gap-4.max-w-md.mx-auto(class="sm:flex-row lg:mx-0")
              a.cta-primary.ultra-btn-primary.ultra-button-master.group.relative.overflow-hidden.px-8.py-4.text-white.font-bold.rounded-2xl.text-center.transition-all.duration-500.transform(
                href="/library/books"
                class="hover:scale-105"
              )
                .relative.z-10
                  🚀 Przeglądaj Książki
              
              a.cta-secondary.ultra-glass.ultra-glass-master.px-8.py-4.border-2.border-white.border-opacity-30.text-white.font-semibold.rounded-2xl.text-center.transition-all.duration-300(
                href="/book/sell"
                class="hover:bg-white hover:text-gray-900 hover:scale-105"
              )
                💰 Sprzedaj Książkę

          // Right Content - Interactive 3D Book Stack
          .hero-visual.relative.flex.justify-center.items-center
            .book-stack-container.ultra-book-stack.relative.w-full.max-w-lg.h-96
              
              // Main Book Stack with Enhanced 3D Effect
              .book-stack.relative.transform.perspective-1000.rotate-y-12
                
                // Individual Books with Ultra Master Effects
                .book.ultra-book.ultra-book-master.absolute.w-64.h-80.bg-gradient-to-br.from-red-500.to-pink-600.rounded-lg.shadow-2xl.transform.transition-all.duration-1000.animate-float-book(
                  style="z-index: 3; transform: translateZ(30px) rotateY(-5deg);"
                )
                  .book-cover.p-6.text-white
                    .text-lg.font-bold Matematyka
                    .text-sm.opacity-80.mt-2 Klasa 8
                    .absolute.bottom-4.right-4.text-xs.bg-white.bg-opacity-20.px-2.py-1.rounded
                      | 45 zł
                
                .book.ultra-book.ultra-book-master.absolute.w-64.h-80.bg-gradient-to-br.from-blue-500.to-indigo-600.rounded-lg.shadow-2xl.transform.transition-all.duration-1000.animate-float-book(
                  style="z-index: 2; transform: translateZ(15px) translateY(10px) rotateY(2deg); animation-delay: 0.5s;"
                )
                  .book-cover.p-6.text-white
                    .text-lg.font-bold Historia
                    .text-sm.opacity-80.mt-2 Klasa 7
                    .absolute.bottom-4.right-4.text-xs.bg-white.bg-opacity-20.px-2.py-1.rounded
                      | 38 zł
                
                .book.ultra-book.ultra-book-master.absolute.w-64.h-80.bg-gradient-to-br.from-green-500.to-teal-600.rounded-lg.shadow-2xl.transform.transition-all.duration-1000.animate-float-book(
                  style="z-index: 1; transform: translateZ(0px) translateY(20px) rotateY(8deg); animation-delay: 1s;"
                )
                  .book-cover.p-6.text-white
                    .text-lg.font-bold Biologia
                    .text-sm.opacity-80.mt-2 Klasa 6
                    .absolute.bottom-4.right-4.text-xs.bg-white.bg-opacity-20.px-2.py-1.rounded
                      | 42 zł
                
              // Ultra Master Floating UI Elements
              .floating-ui.ultra-floating.ultra-floating-master.absolute.top-10.right-10.rounded-2xl.p-4.shadow-xl
                .flex.items-center.gap-3
                  .w-8.h-8.bg-green-100.rounded-full.flex.items-center.justify-center
                    | ✅
                  .text-sm.font-semibold.text-gray-800 Nowa sprzedaż!
              
              .floating-ui.ultra-floating.ultra-floating-master.absolute.bottom-20.left-0.rounded-2xl.p-4.shadow-xl(
                style="animation-delay: 1.5s;"
              )
                .flex.items-center.gap-3
                  .w-8.h-8.bg-blue-100.rounded-full.flex.items-center.justify-center
                    | 📚
                  .text-sm.font-semibold.text-gray-800 +127 książek dziś

    // Features Section with Cards
    section.features.relative.z-10.py-20.px-4.bg-white.bg-opacity-5.backdrop-blur-sm
      .container.mx-auto.max-w-6xl
        .text-center.mb-16
          h2.text-4xl.font-bold.text-white.mb-4 Dlaczego wybrać SignumLBRI?
          p.text-xl.text-blue-100 Najlepsze funkcje na rynku edukacyjnym
        
        .grid.gap-8(class="md:grid-cols-3")
          // Feature 1 - Ultra Master
          .feature-card.ultra-feature.ultra-feature-master.group.p-8.rounded-3xl.text-center.transform.transition-all.duration-500(
            class="hover:scale-105"
          )
            .feature-icon.ultra-icon.w-16.h-16.mx-auto.mb-6.rounded-2xl.flex.items-center.justify-center.text-white.text-2xl.transform.transition-transform.duration-500.group-hover:rotate-12
              | 🚀
            h3.text-xl.font-bold.text-white.mb-4 Super Szybkie
            p.text-blue-100.leading-relaxed Znajdź książkę w sekundach dzięki zaawansowanemu wyszukiwarkowi AI
          
          // Feature 2 - Ultra Master
          .feature-card.ultra-feature.ultra-feature-master.group.p-8.rounded-3xl.text-center.transform.transition-all.duration-500(
            class="hover:scale-105"
          )
            .feature-icon.ultra-icon.w-16.h-16.mx-auto.mb-6.rounded-2xl.flex.items-center.justify-center.text-white.text-2xl.transform.transition-transform.duration-500.group-hover:rotate-12
              | 🛡️
            h3.text-xl.font-bold.text-white.mb-4 100% Bezpieczne
            p.text-blue-100.leading-relaxed Wszystkie transakcje chronione najnowszymi protokołami bezpieczeństwa
          
          // Feature 3 - Ultra Master
          .feature-card.ultra-feature.ultra-feature-master.group.p-8.rounded-3xl.text-center.transform.transition-all.duration-500(
            class="hover:scale-105"
          )
            .feature-icon.ultra-icon.w-16.h-16.mx-auto.mb-6.rounded-2xl.flex.items-center.justify-center.text-white.text-2xl.transform.transition-transform.duration-500.group-hover:rotate-12
              | 💰
            h3.text-xl.font-bold.text-white.mb-4 Najlepsze Ceny
            p.text-blue-100.leading-relaxed Oszczędzaj do 70% na książkach szkolnych dzięki naszej platformie

    // Ultra Master Call to Action Section
    section.final-cta.relative.z-10.py-20.px-4
      .container.mx-auto.max-w-4xl.text-center
        .cta-card.ultra-cta.ultra-cta-master.p-12.rounded-3xl.shadow-2xl.transform.transition-all.duration-500(
          class="hover:scale-105"
        )
          .relative.z-10
            h2.text-4xl.font-bold.text-white.mb-6 Gotowy na nową erę książek szkolnych?
            p.text-xl.text-blue-100.mb-8.max-w-2xl.mx-auto
              | Dołącz do tysięcy zadowolonych użytkowników już dziś!
            
            .flex.flex-col.gap-4.max-w-md.mx-auto(class="sm:flex-row")
              a.ultra-btn-primary.ultra-button-master.px-8.py-4.text-white.font-bold.rounded-2xl.text-center.transition-all.duration-300.shadow-lg(
                href="/register"
                class="hover:shadow-xl hover:scale-105"
              )
                🎉 Zarejestruj się za darmo
              
              a.ultra-glass.ultra-glass-master.px-8.py-4.border-2.border-white.text-white.font-semibold.rounded-2xl.text-center.transition-all.duration-300(
                href="/library/books"
                class="hover:bg-white hover:text-blue-600 hover:scale-105"
              )
                📚 Zobacz książki
                
                a.glass-modern.px-8.py-4.bg-white.text-blue-500.border-2.border-blue-500.rounded-xl.font-semibold.text-center.transition-all.duration-300(
                  href="/login"
                  class="hover:bg-blue-50 hover:scale-105"
                )
                  | 👤 Mam już konto
          
          // Right Visual
          .relative.text-center(class="lg:pl-8")
            .glass-card.p-8.rounded-3xl
              .text-6xl.mb-4 📚
              h3.text-xl.font-semibold.text-gray-900.mb-2
                | Łatwe zarządzanie
              p.text-gray-600
                | Wszystko czego potrzebujesz w jednym miejscu
    
    // How It Works Section
    section.py-20.px-4.bg-white
      .container.mx-auto.max-w-6xl
        .text-center.mb-16
          h2.text-3xl.font-bold.text-gray-900.mb-4(class="lg:text-4xl")
            | Jak to działa?
          p.text-xl.text-gray-600
            | Prosty proces w 3 krokach
        
        .grid.gap-8(class="md:grid-cols-3")
          
          // Step 1
          .glass-card.p-8.text-center.rounded-2xl
            .w-16.h-16.bg-green-500.rounded-full.flex.items-center.justify-center.mb-6.mx-auto.text-white.text-2xl.font-bold
              | 1
            h3.text-xl.font-bold.text-gray-900.mb-4
              | Zarejestruj się
            p.text-gray-600.mb-6
              | Stwórz bezpłatne konto dla swojej szkoły, jako uczeń lub rodzic
            a.inline-block.px-6.py-3.bg-green-500.text-white.rounded-lg.font-medium.transition-colors.duration-300(
              href="/register"
              class="hover:bg-green-600"
            )
              | Załóż konto
          
          // Step 2  
          .glass-card.p-8.text-center.rounded-2xl
            .w-16.h-16.bg-blue-500.rounded-full.flex.items-center.justify-center.mb-6.mx-auto.text-white.text-2xl.font-bold
              | 2
            h3.text-xl.font-bold.text-gray-900.mb-4
              | Przeglądaj książki
            p.text-gray-600.mb-6
              | Znajdź potrzebne podręczniki w naszej bazie danych tysięcy tytułów
            a.inline-block.px-6.py-3.bg-blue-500.text-white.rounded-lg.font-medium.transition-colors.duration-300(
              href="/library"
              class="hover:bg-blue-600"
            )
              | Zobacz bibliotekę
          
          // Step 3
          .glass-card.p-8.text-center.rounded-2xl
            .w-16.h-16.bg-purple-500.rounded-full.flex.items-center.justify-center.mb-6.mx-auto.text-white.text-2xl.font-bold
              | 3
            h3.text-xl.font-bold.text-gray-900.mb-4
              | Kup lub sprzedaj
            p.text-gray-600.mb-6
              | Bezpieczne transakcje między użytkownikami z pełną kontrolą
            a.inline-block.px-6.py-3.bg-purple-500.text-white.rounded-lg.font-medium.transition-colors.duration-300(
              href="/book/sell"
              class="hover:bg-purple-600"
            )
              | Sprzedaj książkę
    
    // Features Section
    section.py-20.px-4.bg-gray-50
      .container.mx-auto.max-w-6xl
        .text-center.mb-16
          h2.text-3xl.font-bold.text-gray-900.mb-4(class="lg:text-4xl")
            | Dlaczego SignumLBRI?
          p.text-xl.text-gray-600
            | Wszystko czego potrzebujesz dla sukcesu edukacyjnego
        
        .grid.gap-8(class="md:grid-cols-2 lg:grid-cols-3")
          
          // Feature 1
          .glass-card.p-6.rounded-2xl.text-center
            .text-4xl.mb-4 🏫
            h3.text-lg.font-bold.text-gray-900.mb-3
              | Dla szkół
            p.text-gray-600.text-sm
              | Zarządzaj zasobami, śledź dostępność książek
          
          // Feature 2  
          .glass-card.p-6.rounded-2xl.text-center
            .text-4xl.mb-4 🎓
            h3.text-lg.font-bold.text-gray-900.mb-3
              | Dla uczniów
            p.text-gray-600.text-sm
              | Znajdź tanie podręczniki, sprzedaj niepotrzebne
          
          // Feature 3
          .glass-card.p-6.rounded-2xl.text-center
            .text-4xl.mb-4 👨‍👩‍👧‍👦
            h3.text-lg.font-bold.text-gray-900.mb-3
              | Dla rodziców
            p.text-gray-600.text-sm
              | Kontroluj wydatki, pomagaj dzieciom
          
          // Feature 4
          .glass-card.p-6.rounded-2xl.text-center
            .text-4xl.mb-4 🔒
            h3.text-lg.font-bold.text-gray-900.mb-3
              | Bezpieczeństwo
            p.text-gray-600.text-sm
              | Verified users, bezpieczne płatności
          
          // Feature 5
          .glass-card.p-6.rounded-2xl.text-center
            .text-4xl.mb-4 📱
            h3.text-lg.font-bold.text-gray-900.mb-3
              | Mobile first
            p.text-gray-600.text-sm
              | Działa na telefonie i komputerze
          
          // Feature 6
          .glass-card.p-6.rounded-2xl.text-center
            .text-4xl.mb-4 💰
            h3.text-lg.font-bold.text-gray-900.mb-3
              | Oszczędności
            p.text-gray-600.text-sm
              | Do 70% taniej niż nowe książki
    
    // Stats Section
    section.py-20.px-4.bg-blue-600.text-white
      .container.mx-auto.max-w-6xl
        .text-center.mb-16
          h2.text-3xl.font-bold.mb-4(class="lg:text-4xl")
            | SignumLBRI w liczbach
        
        .grid.gap-8.text-center(class="md:grid-cols-3")
          .glass-modern.p-8.rounded-2xl(style="background: rgba(255,255,255,0.1);")
            .text-4xl.font-bold.mb-2(class="lg:text-5xl")
              | 10k+
            p.text-xl.text-blue-100
              | Aktywnych użytkowników
          
          .glass-modern.p-8.rounded-2xl(style="background: rgba(255,255,255,0.1);")
            .text-4xl.font-bold.mb-2(class="lg:text-5xl")
              | 50k+
            p.text-xl.text-blue-100
              | Książek w bazie
          
          .glass-modern.p-8.rounded-2xl(style="background: rgba(255,255,255,0.1);")
            .text-4xl.font-bold.mb-2(class="lg:text-5xl")
              | 95%
            p.text-xl.text-blue-100
              | Zadowolonych klientów
    
    // CTA Final Section
    section.py-20.px-4.bg-gray-900.text-white
      .container.mx-auto.max-w-4xl.text-center
        h2.text-3xl.font-bold.mb-6(class="lg:text-4xl")
          | Gotowy zacząć?
        p.text-xl.text-gray-300.mb-8
          | Dołącz do tysięcy użytkowników którzy już oszczędzają na podręcznikach
        
        .flex.flex-col.gap-4.max-w-md.mx-auto(class="sm:flex-row sm:max-w-none")
          a.glass-modern.px-8.py-4.bg-blue-500.text-white.rounded-xl.font-bold.text-center.transition-all.duration-300.flex-1(
            href="/register"
            class="hover:bg-blue-600 hover:scale-105"
          )
            | 🚀 Zacznij teraz - za darmo
          
          a.glass-modern.px-8.py-4.bg-transparent.border-2.border-white.text-white.rounded-xl.font-bold.text-center.transition-all.duration-300.flex-1(
            href="/library"
            class="hover:bg-white hover:text-gray-900"
          )
            | 📚 Przeglądaj książki

// Modern Landing Page Interactive Scripts
script(defer, src='/js/landing-interactive.js')
script(defer, src='/js/scroll-enhancer.js')
script(defer, src='/js/ultra-premium.js')
