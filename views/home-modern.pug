extends ../layout_tailwindcss
include ../mixins/modern-carousel

block content
  //- Modern Homepage with Carousel - 2025 Design Standards
  
  //- Hero Section with Carousel
  section.hero-section.relative.min-h-screen.overflow-hidden
    +modern-carousel({
      id: 'hero-carousel',
      autoAdvance: true,
      showDots: true,
      showArrows: true,
      transitionDuration: 500,
      slides: [
        {
          type: 'image',
          imageUrl: 'https://images.unsplash.com/photo-1522202176988-66273c2fd55f?ixlib=rb-4.0.3&auto=format&fit=crop&w=1920&q=80',
          subtitle: 'Nowoczesna Edukacja',
          title: 'SignumLBRI',
          description: 'Platforma księgarska łącząca szkoły, uczniów i rodziców w nowoczesnym ekosystemie edukacyjnym. Odkryj przyszłość nauki razem z nami.',
          ctaText: 'Rozpocznij Przygodę',
          ctaUrl: '/register'
        },
        {
          type: 'image',
          imageUrl: 'https://images.unsplash.com/photo-1481627834876-b7833e8f5570?ixlib=rb-4.0.3&auto=format&fit=crop&w=1920&q=80',
          subtitle: 'Dla Szkół',
          title: 'Zarządzaj Podręcznikami',
          description: 'Kompleksowe rozwiązanie dla placówek edukacyjnych. Efektywne zarządzanie zasobami książkowymi, automatyzacja procesów i wsparcie dla uczniów.',
          ctaText: 'Sprawdź Możliwości',
          ctaUrl: '/schools'
        },
        {
          type: 'image',
          imageUrl: 'https://images.unsplash.com/photo-1513475382585-d06e58bcb0e0?ixlib=rb-4.0.3&auto=format&fit=crop&w=1920&q=80',
          subtitle: 'Dla Uczniów',
          title: 'Twoja Biblioteka Online',
          description: 'Dostęp do podręczników, materiałów dodatkowych i narzędzi edukacyjnych w jednym miejscu. Nauka staje się prostsza i bardziej efektywna.',
          ctaText: 'Dołącz Teraz',
          ctaUrl: '/student-portal'
        }
      ]
    })
  
  //- Quick Access Cards for Non-Authenticated Users
  section.quick-access.py-16.px-4.bg-gradient-to-b.from-slate-50.to-white
    .container.mx-auto.max-w-6xl
      .text-center.mb-12
        h2(class="text-3xl md:text-4xl font-bold text-gray-900 mb-4")
          | Szybki Dostęp
        p(class="text-xl text-gray-600 max-w-3xl mx-auto")
          | Poznaj nasze rozwiązania dostosowane do potrzeb różnych grup użytkowników
      
      .grid(class="md:grid-cols-2 lg:grid-cols-3 gap-8")
        //- School Card
        .glass-card.group
          .relative.p-8(class="bg-white/60 backdrop-blur-sm rounded-2xl shadow-lg border border-white/20 transition-all duration-300 hover:shadow-2xl hover:scale-105 hover:bg-white/70")
            .absolute.inset-0(class="bg-gradient-to-br from-blue-500/10 to-purple-500/10 rounded-2xl opacity-0 group-hover:opacity-100 transition-opacity duration-300")
            .relative.z-10
              .w-16.h-16.bg-blue-500.rounded-xl.flex.items-center.justify-center.mb-6.mx-auto.group-hover:scale-110.transition-transform.duration-300
                svg.w-8.h-8.text-white(fill="none" stroke="currentColor" viewBox="0 0 24 24")
                  path(stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4")
              h3.text-xl.font-bold.text-gray-900.mb-3.text-center
                | Dla Szkół
              p.text-gray-600.text-center.mb-6
                | Kompleksowe zarządzanie podręcznikami, zamówieniami i uczniami w Twojej placówce edukacyjnej.
              .text-center
                a.inline-flex.items-center.px-6.py-3.bg-blue-500.text-white.rounded-lg.font-semibold.transition-all.duration-300.hover:bg-blue-600.hover:shadow-lg.focus:outline-none.focus:ring-4.focus:ring-blue-500/30(
                  href="/schools"
                )
                  | Dowiedz się więcej
                  svg.ml-2.w-4.h-4.transition-transform.duration-300.group-hover:translate-x-1(
                    fill="none" stroke="currentColor" viewBox="0 0 24 24"
                  )
                    path(stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6")
        
        //- Student Card  
        .glass-card.group
          .relative.p-8(class="bg-white/60 backdrop-blur-sm rounded-2xl shadow-lg border border-white/20 transition-all duration-300 hover:shadow-2xl hover:scale-105 hover:bg-white/70")
            .absolute.inset-0(class="bg-gradient-to-br from-green-500/10 to-blue-500/10 rounded-2xl opacity-0 group-hover:opacity-100 transition-opacity duration-300")
            .relative.z-10
              .w-16.h-16.bg-green-500.rounded-xl.flex.items-center.justify-center.mb-6.mx-auto.group-hover:scale-110.transition-transform.duration-300
                svg.w-8.h-8.text-white(fill="none" stroke="currentColor" viewBox="0 0 24 24")
                  path(stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.746 0 3.332.477 4.5 1.253v13C19.832 18.477 18.246 18 16.5 18c-1.746 0-3.332.477-4.5 1.253")
              h3.text-xl.font-bold.text-gray-900.mb-3.text-center
                | Dla Uczniów
              p.text-gray-600.text-center.mb-6
                | Dostęp do podręczników, materiałów edukacyjnych i narzędzi wspierających naukę w jednym miejscu.
              .text-center
                a.inline-flex.items-center.px-6.py-3.bg-green-500.text-white.rounded-lg.font-semibold.transition-all.duration-300.hover:bg-green-600.hover:shadow-lg.focus:outline-none.focus:ring-4.focus:ring-green-500/30(
                  href="/student-portal"
                )
                  | Zobacz możliwości
                  svg.ml-2.w-4.h-4.transition-transform.duration-300.group-hover:translate-x-1(
                    fill="none" stroke="currentColor" viewBox="0 0 24 24"
                  )
                    path(stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6")
        
        //- Parent Card
        .glass-card.group
          .relative.p-8(class="bg-white/60 backdrop-blur-sm rounded-2xl shadow-lg border border-white/20 transition-all duration-300 hover:shadow-2xl hover:scale-105 hover:bg-white/70")
            .absolute.inset-0(class="bg-gradient-to-br from-purple-500/10 to-pink-500/10 rounded-2xl opacity-0 group-hover:opacity-100 transition-opacity duration-300")
            .relative.z-10
              .w-16.h-16.bg-purple-500.rounded-xl.flex.items-center.justify-center.mb-6.mx-auto.group-hover:scale-110.transition-transform.duration-300
                svg.w-8.h-8.text-white(fill="none" stroke="currentColor" viewBox="0 0 24 24")
                  path(stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z")
              h3.text-xl.font-bold.text-gray-900.mb-3.text-center
                | Dla Rodziców
              p.text-gray-600.text-center.mb-6
                | Monitoruj postępy swojego dziecka, zarządzaj zamówieniami i bądź na bieżąco z edukacją.
              .text-center
                a.inline-flex.items-center.px-6.py-3.bg-purple-500.text-white.rounded-lg.font-semibold.transition-all.duration-300.hover:bg-purple-600.hover:shadow-lg.focus:outline-none.focus:ring-4.focus:ring-purple-500/30(
                  href="/parent-portal"
                )
                  | Sprawdź panel
                  svg.ml-2.w-4.h-4.transition-transform.duration-300.group-hover:translate-x-1(
                    fill="none" stroke="currentColor" viewBox="0 0 24 24"
                  )
                    path(stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6")

  //- Features Section
  section.features.py-20.px-4.bg-white
    .container.mx-auto.max-w-6xl
      .text-center.mb-16
        h2(class="text-3xl md:text-4xl font-bold text-gray-900 mb-4")
          | Dlaczego SignumLBRI?
        p(class="text-xl text-gray-600 max-w-3xl mx-auto")
          | Nowoczesne rozwiązania technologiczne wspierające edukację na każdym poziomie
      
      .grid(class="md:grid-cols-2 lg:grid-cols-3 gap-8")
        //- Feature 1
        .feature-card.text-center.group
          .w-20.h-20.bg-gradient-to-br.from-blue-500.to-blue-600.rounded-2xl.flex.items-center.justify-center.mb-6.mx-auto.group-hover:scale-110.group-hover:rotate-3.transition-all.duration-300
            svg.w-10.h-10.text-white(fill="none" stroke="currentColor" viewBox="0 0 24 24")
              path(stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z")
          h3.text-xl.font-bold.text-gray-900.mb-3
            | Łatwość Użytkowania
          p.text-gray-600
            | Intuicyjny interfejs dostosowany do potrzeb wszystkich użytkowników - od uczniów po administratorów szkół.
        
        //- Feature 2
        .feature-card.text-center.group
          .w-20.h-20.bg-gradient-to-br.from-green-500.to-green-600.rounded-2xl.flex.items-center.justify-center.mb-6.mx-auto.group-hover:scale-110.group-hover:rotate-3.transition-all.duration-300
            svg.w-10.h-10.text-white(fill="none" stroke="currentColor" viewBox="0 0 24 24")
              path(stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z")
          h3.text-xl.font-bold.text-gray-900.mb-3
            | Szybkość Działania
          p.text-gray-600
            | Optymalizowana wydajność zapewniająca płynne działanie nawet przy dużym obciążeniu użytkowników.
        
        //- Feature 3
        .feature-card.text-center.group
          .w-20.h-20.bg-gradient-to-br.from-purple-500.to-purple-600.rounded-2xl.flex.items-center.justify-center.mb-6.mx-auto.group-hover:scale-110.group-hover:rotate-3.transition-all.duration-300
            svg.w-10.h-10.text-white(fill="none" stroke="currentColor" viewBox="0 0 24 24")
              path(stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z")
          h3.text-xl.font-bold.text-gray-900.mb-3
            | Bezpieczeństwo Danych
          p.text-gray-600
            | Najwyższe standardy ochrony danych osobowych i bezpieczeństwa transakcji zgodnie z RODO.
        
        //- Feature 4
        .feature-card.text-center.group
          .w-20.h-20.bg-gradient-to-br.from-orange-500.to-orange-600.rounded-2xl.flex.items-center.justify-center.mb-6.mx-auto.group-hover:scale-110.group-hover:rotate-3.transition-all.duration-300
            svg.w-10.h-10.text-white(fill="none" stroke="currentColor" viewBox="0 0 24 24")
              path(stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z")
          h3.text-xl.font-bold.text-gray-900.mb-3
            | Wsparcie 24/7
          p.text-gray-600
            | Dedykowany zespół wsparcia technicznego gotowy do pomocy w każdej sytuacji.
        
        //- Feature 5
        .feature-card.text-center.group
          .w-20.h-20.bg-gradient-to-br.from-indigo-500.to-indigo-600.rounded-2xl.flex.items-center.justify-center.mb-6.mx-auto.group-hover:scale-110.group-hover:rotate-3.transition-all.duration-300
            svg.w-10.h-10.text-white(fill="none" stroke="currentColor" viewBox="0 0 24 24")
              path(stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v4a2 2 0 01-2 2h-2a2 2 0 00-2 2z")
          h3.text-xl.font-bold.text-gray-900.mb-3
            | Analityki i Raporty
          p.text-gray-600
            | Szczegółowe analizy wykorzystania zasobów i raporty wspierające podejmowanie decyzji edukacyjnych.
        
        //- Feature 6
        .feature-card.text-center.group
          .w-20.h-20.bg-gradient-to-br.from-pink-500.to-pink-600.rounded-2xl.flex.items-center.justify-center.mb-6.mx-auto.group-hover:scale-110.group-hover:rotate-3.transition-all.duration-300
            svg.w-10.h-10.text-white(fill="none" stroke="currentColor" viewBox="0 0 24 24")
              path(stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z")
          h3.text-xl.font-bold.text-gray-900.mb-3
            | Aplikacja Mobilna
          p.text-gray-600
            | Dostęp do wszystkich funkcji z urządzeń mobilnych - nauka i zarządzanie w każdym miejscu.

  //- CTA Section
  section.cta.py-20.px-4.bg-gradient-to-r.from-blue-600.via-purple-600.to-indigo-600.relative.overflow-hidden
    .absolute.inset-0.bg-black/20
    .absolute.inset-0.bg-gradient-to-r.from-blue-600/80.to-purple-600/80
    .relative.z-10.container.mx-auto.max-w-4xl.text-center.text-white
      h2(class="text-3xl md:text-5xl font-bold mb-6 leading-tight")
        | Gotowy na Nową Erę Edukacji?
      p(class="text-xl md:text-2xl mb-8 text-blue-100 max-w-3xl mx-auto")
        | Dołącz do tysięcy szkół i uczniów, którzy już korzystają z SignumLBRI
      .flex(class="flex-col sm:flex-row gap-4 justify-center items-center")
        a.inline-flex.items-center.px-8.py-4.bg-white.text-blue-600.font-bold.rounded-full.transition-all.duration-300.hover:bg-blue-50.hover:scale-105.hover:shadow-2xl.focus:outline-none.focus:ring-4.focus:ring-white/30(
          href="/register"
          class="group"
        )
          | Załóż Konto Bezpłatnie
          svg.ml-3.w-5.h-5.transition-transform.duration-300.group-hover:translate-x-1(
            fill="none" stroke="currentColor" viewBox="0 0 24 24"
          )
            path(stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6")
        a.inline-flex.items-center.px-8.py-4.border-2.border-white.text-white.font-bold.rounded-full.transition-all.duration-300.hover:bg-white.hover:text-blue-600.hover:scale-105.focus:outline-none.focus:ring-4.focus:ring-white/30(
          href="/demo"
          class="group"
        )
          | Zobacz Demo
          svg.ml-3.w-5.h-5.transition-transform.duration-300.group-hover:translate-x-1(
            fill="none" stroke="currentColor" viewBox="0 0 24 24"
          )
            path(stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.828 14.828a4 4 0 01-5.656 0M9 10h1m4 0h1m-6 4h8m-5-9a9 9 0 11-18 0 9 9 0 0118 0z")

block append scripts
  +carousel-script()
  +carousel-styles()
