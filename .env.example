# SignumLBRI 2025 Ultra Edition - Environment Configuration
# Copy this file to .env and customize for your environment
# SECURITY WARNING: Never commit .env to version control!

# ===========================================
# SERVER CONFIGURATION
# ===========================================
NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# ===========================================
# DATABASE CONFIGURATION - ULTRA SECURE
# ===========================================

# MongoDB Root User (for admin operations)
MONGO_ROOT_USERNAME=admin
MONGO_ROOT_PASSWORD=CHANGE_ME_ULTRA_SECURE_ROOT_PASSWORD_2025

# MongoDB Application User (limited privileges)
MONGO_APP_USERNAME=signumlbri_user
MONGO_APP_PASSWORD=CHANGE_ME_ULTRA_SECURE_APP_PASSWORD_2025

# Database Name
MONGO_DB_NAME=signumlbri

# Full MongoDB Connection URI (Production)
MONGODB_URI=mongodb://signumlbri_user:CHANGE_ME_ULTRA_SECURE_APP_PASSWORD_2025@mongo:27017/signumlbri?authSource=signumlbri

# Development MongoDB URI
# MONGODB_URI=mongodb://signum_dev:dev_password_2025@localhost:27017/signumlbri_dev?authSource=admin

# =================
# REDIS CONFIG
# =================

# Redis Configuration - CHANGE THESE PASSWORDS!
REDIS_PASSWORD=CHANGE_ME_SECURE_REDIS_PASSWORD_2025

# Redis Connection URL
REDIS_URL=redis://:CHANGE_ME_SECURE_REDIS_PASSWORD_2025@redis:6379

# ==================
# APPLICATION SECURITY
# =================

# Session Secret (generate with: openssl rand -base64 32)
SESSION_SECRET=CHANGE_ME_GENERATE_RANDOM_32_BYTE_SESSION_SECRET

# JWT Secret for API tokens (generate with: openssl rand -base64 32)
JWT_SECRET=CHANGE_ME_GENERATE_RANDOM_32_BYTE_JWT_SECRET

# Encryption Key for sensitive data (generate with: openssl rand -base64 32)
ENCRYPTION_KEY=CHANGE_ME_GENERATE_RANDOM_32_BYTE_ENCRYPTION_KEY

# =================
# EMAIL CONFIG
# =================

# SendGrid API Key (or other email provider)
SENDGRID_API_KEY=SG.CHANGE_ME_WITH_REAL_SENDGRID_KEY

# Email sender address
EMAIL_FROM=samorzad@elektryk.opole.pl

# Email settings
MAIL_HOST=smtp.sendgrid.net
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=apikey
MAIL_PASSWORD=${SENDGRID_API_KEY}

# =================
# FILE UPLOAD CONFIG
# =================

# Maximum file size in bytes (10MB)
MAX_FILE_SIZE=10485760

# Allowed file types (comma-separated)
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/gif,image/webp

# Upload directory
UPLOAD_PATH=/app/public/uploads

# =================
# RATE LIMITING
# =================

# Rate limit window in milliseconds (15 minutes)
RATE_LIMIT_WINDOW=900000

# Maximum requests per window
RATE_LIMIT_MAX_REQUESTS=100

# Login rate limit (per minute)
LOGIN_RATE_LIMIT=5

# API rate limit (per minute)
API_RATE_LIMIT=60

# =================
# CORS & SECURITY
# =================

# Allowed CORS origins (comma-separated)
CORS_ORIGIN=https://yourdomain.com,https://www.yourdomain.com

# Enable security headers
HELMET_ENABLED=true

# Content Security Policy
CSP_ENABLED=true

# =================
# APPLICATION CONFIG
# =================

# Environment
NODE_ENV=production

# Application port
PORT=3000

# Application name
APP_NAME=SignumLBRI - System Targów Książkowych

# Admin contact email
ADMIN_EMAIL=samorzad@elektryk.opole.pl

# Application URL (for email links)
APP_URL=https://yourdomain.com

# =================
# INITIAL SETUP
# =================

# Initial admin user (will be created on first startup)
INITIAL_ADMIN_EMAIL=samorzad@elektryk.opole.pl
INITIAL_ADMIN_PASSWORD=CHANGE_ME_INITIAL_ADMIN_PASSWORD
INITIAL_ADMIN_FIRST_NAME=Administrator
INITIAL_ADMIN_LAST_NAME=Systemu

# Initial school data
INITIAL_SCHOOL_NAME=Zespół Szkół Elektronicznych w Opolu
INITIAL_SCHOOL_ADDRESS=ul. Prószkowska 76, 45-758 Opole
INITIAL_SCHOOL_PHONE=+48 77 454 29 15
INITIAL_SCHOOL_EMAIL=sekretariat@elektryk.opole.pl
INITIAL_SCHOOL_WEBSITE=https://elektryk.opole.pl

# =================
# MONITORING & LOGGING
# =================

# Log level (error, warn, info, debug)
LOG_LEVEL=info

# Log to file
LOG_TO_FILE=true

# Log file path
LOG_FILE_PATH=/app/logs/application.log

# Elasticsearch for log aggregation (optional)
ELASTICSEARCH_HOSTS=http://elasticsearch:9200

# =================
# BACKUP CONFIG
# =================

# Backup schedule (cron format)
BACKUP_SCHEDULE=0 2 * * *

# Backup retention days
BACKUP_RETENTION_DAYS=30

# Backup storage path
BACKUP_PATH=/app/backups

# =================
# DEVELOPMENT SETTINGS
# =================
# (Remove these in production)

# Debug mode
DEBUG=false

# Show detailed errors
SHOW_STACK_TRACE=false

# Mock email sending
MOCK_EMAIL_SENDING=false

# =================
# SSL/TLS CONFIG
# =================

# Force HTTPS redirect
FORCE_HTTPS=true

# HSTS max age (1 year)
HSTS_MAX_AGE=31536000

# SSL certificate paths (for nginx)
SSL_CERT_PATH=/etc/nginx/ssl/cert.crt
SSL_KEY_PATH=/etc/nginx/ssl/cert.key

# ===========================================
# ENHANCED SYSTEMS CONFIGURATION
# ===========================================

# Enhanced Systems Feature Flags
ENABLE_PERFORMANCE_MONITORING=true
ENABLE_ENHANCED_LOGGING=true
ENABLE_ADVANCED_CACHING=true
ENABLE_ERROR_TRACKING=true

# Enhanced Logging Configuration
ENHANCED_LOG_LEVEL=info
ENHANCED_LOG_TO_CONSOLE=true
ENHANCED_LOG_TO_FILE=true
ENHANCED_LOG_FILE_PATH=./logs/enhanced
ENHANCED_LOG_MAX_SIZE=10485760
ENHANCED_LOG_MAX_FILES=5
ENHANCED_LOG_STRUCTURED=true

# Performance Monitoring
PERFORMANCE_MONITORING_INTERVAL=30000
ALERT_RESPONSE_TIME_THRESHOLD=2000
ALERT_MEMORY_THRESHOLD=0.8
ALERT_CPU_THRESHOLD=0.8
PERFORMANCE_HISTORY_SIZE=1000

# Enhanced Cache Configuration
ENHANCED_CACHE_DEFAULT_TTL=300
ENHANCED_CACHE_MAX_SIZE=1000
ENHANCED_CACHE_ENABLE_COMPRESSION=true
ENHANCED_CACHE_WARM_UP_ON_START=true
ENHANCED_CACHE_STRATEGY=write-through

# Enhanced Error Handling
ERROR_TRACKING_ENABLED=true
ERROR_SANITIZE_SENSITIVE_DATA=true
ERROR_INCLUDE_STACK_TRACE=false
ERROR_MAX_STACK_FRAMES=10

# Enhanced Route Configuration
ROUTE_VALIDATION_ENABLED=true
ROUTE_AUTHENTICATION_REQUIRED=true
ROUTE_RATE_LIMITING_ENABLED=true
ROUTE_CACHING_ENABLED=true

# System Health Monitoring
HEALTH_CHECK_ENHANCED=true
HEALTH_CHECK_DATABASE=true
HEALTH_CHECK_REDIS=true
HEALTH_CHECK_EXTERNAL_SERVICES=true

# Development Enhanced Features
DEV_ENABLE_DEBUG_ROUTES=true
DEV_ENABLE_PERFORMANCE_PROFILING=true
DEV_ENABLE_ENHANCED_LOGGING_DEBUG=true
DEV_ENABLE_CACHE_DEBUGGING=true

# Enhanced Security Configuration
ENHANCED_SECURITY_ENABLED=true
ENHANCED_SECURITY_RATE_LIMITING=true
ENHANCED_SECURITY_CORS_ENABLED=true
ENHANCED_SECURITY_HELMET_ENABLED=true

# Enhanced Business Logic
ENHANCED_MODELS_ENABLED=true
ENHANCED_VALIDATION_ENABLED=true
ENHANCED_SEARCH_ENABLED=true
ENHANCED_RECOMMENDATIONS_ENABLED=true
