# SignumLBRI Development Dockerfile - 2025 Edition
# Optimized for development with hot-reload, debugging, and fast iteration
FROM node:20-alpine

# Install system dependencies
RUN apk add --no-cache \
    git \
    python3 \
    make \
    g++ \
    curl \
    nano \
    dumb-init

# Set working directory
WORKDIR /app

# Create non-root user for development
RUN addgroup -g 1001 -S nodejs && adduser -S signumlbri -u 1001 -G nodejs

# Copy package files
COPY package*.json ./
COPY tsconfig.json ./
COPY webpack.config.js ./
COPY copyStaticAssets.ts ./

# Install all dependencies including dev dependencies
RUN npm install

# Copy source code (will be mounted as volume in development)
COPY src/ ./src/
COPY views/ ./views/
COPY public/ ./public/

# Create required directories
RUN mkdir -p /app/logs /app/uploads /app/dist /app/tmp && \
    chown -R signumlbri:nodejs /app

# Set environment for development
ENV NODE_ENV=development \
    PORT=3000 \
    DEBUG=signum:*

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD curl -f http://localhost:3000/health || exit 1

# Switch to non-root user
USER signumlbri

# Expose port
EXPOSE 3000

# Use dumb-init for proper signal handling
ENTRYPOINT ["dumb-init", "--"]

# Start in development mode with watch
CMD ["npm", "run", "watch"]
