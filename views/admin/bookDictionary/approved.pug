extends ../layout

block content
  .min-h-screen.bg-gradient-to-br.from-green-50.to-emerald-100.py-8
    .container.mx-auto.px-4.max-w-7xl
      
      // Header Section
      .bg-white.rounded-lg.shadow-md.p-6.mb-6
        .flex.justify-between.items-start
          div
            h1.text-3xl.font-bold.text-gray-800.mb-2 ✅ Zatwierdzone Wpisy Słownika (#{totalCount})
            p.text-gray-600 Przeglądaj zatwierdzone książki w słowniku systemowym
          
          .flex.space-x-3
            a(href="/admin/book-dictionary/pending").bg-yellow-600.hover:bg-yellow-700.text-white.px-4.py-2.rounded-md
              | ⏳ Oczekujące
            a(href="/admin/book-dictionary/import").bg-blue-600.hover:bg-blue-700.text-white.px-4.py-2.rounded-md
              | 📤 Importuj CSV
        
        // Search Form
        form(method="get").mt-4
          .flex.space-x-4
            input(type="text" name="search" value=search placeholder="Szukaj po tytule, wydawcy, autorach, ISBN...").flex-1.px-3.py-2.border.border-gray-300.rounded-md
            button(type="submit").bg-gray-600.hover:bg-gray-700.text-white.px-6.py-2.rounded-md 🔍 Szukaj
            if search
              a(href="/admin/book-dictionary/approved").bg-gray-400.hover:bg-gray-500.text-white.px-4.py-2.rounded-md 🗑️ Wyczyść

      if entries && entries.length > 0
        // Search API Demo
        .bg-blue-50.rounded-lg.p-4.mb-6
          h3.text-lg.font-semibold.text-blue-800.mb-2 🔍 Test API Wyszukiwania
          p.text-blue-700.text-sm.mb-3 Przetestuj API wyszukiwania słownika (endpoint: /api/book-dictionary/search)
          
          .flex.space-x-4
            input(type="text" id="searchApi" placeholder="Wpisz frazę do wyszukania..." maxlength="50").flex-1.px-3.py-2.border.border-blue-300.rounded-md
            button(onclick="testSearchApi()").bg-blue-600.hover:bg-blue-700.text-white.px-4.py-2.rounded-md 🔍 Test API
          
          #searchResults.mt-4.hidden
            h4.font-semibold.text-blue-800.mb-2 Wyniki API:
            #apiResultsContainer.bg-white.p-3.rounded.border.max-h-40.overflow-y-auto

        // Entries Table
        .bg-white.rounded-lg.shadow-md.overflow-hidden
          .overflow-x-auto
            table.min-w-full.divide-y.divide-gray-200
              thead.bg-gray-50
                tr
                  th.px-6.py-3.text-left.text-xs.font-medium.text-gray-500.uppercase.tracking-wider ISBN
                  th.px-6.py-3.text-left.text-xs.font-medium.text-gray-500.uppercase.tracking-wider Tytuł
                  th.px-6.py-3.text-left.text-xs.font-medium.text-gray-500.uppercase.tracking-wider Wydawca
                  th.px-6.py-3.text-left.text-xs.font-medium.text-gray-500.uppercase.tracking-wider Autorzy
                  th.px-6.py-3.text-left.text-xs.font-medium.text-gray-500.uppercase.tracking-wider Rok
                  th.px-6.py-3.text-left.text-xs.font-medium.text-gray-500.uppercase.tracking-wider Ceny
                  th.px-6.py-3.text-left.text-xs.font-medium.text-gray-500.uppercase.tracking-wider Status
              tbody.bg-white.divide-y.divide-gray-200
                each entry in entries
                  tr.hover:bg-gray-50
                    td.px-6.py-4.whitespace-nowrap.text-sm.font-mono.text-gray-900
                      = entry.isbn
                      .text-xs.text-gray-400 #{entry._id.toString().slice(-8)}
                    td.px-6.py-4.text-sm.text-gray-900
                      .font-semibold= entry.title
                      if entry.subject
                        .text-xs.text-purple-600.mt-1 Przedmiot: #{entry.subject}
                      if entry.grade
                        .text-xs.text-orange-600 Klasa: #{entry.grade}
                    td.px-6.py-4.whitespace-nowrap.text-sm.text-gray-900= entry.publisher
                    td.px-6.py-4.text-sm.text-gray-900= entry.authors
                    td.px-6.py-4.whitespace-nowrap.text-sm.text-gray-900
                      .font-semibold= entry.year
                    td.px-6.py-4.whitespace-nowrap.text-sm.text-gray-900
                      .text-green-600.font-semibold Nowa: #{entry.newPrice}zł
                      .text-blue-600 Używana: #{entry.usedPrice}zł
                    td.px-6.py-4.whitespace-nowrap.text-sm
                      .inline-flex.items-center.px-2.5.py-0.5.rounded-full.text-xs.font-medium.bg-green-100.text-green-800
                        | ✅ Zatwierdzono
                      .text-xs.text-gray-500.mt-1
                        = new Date(entry.reviewedAt).toLocaleString('pl-PL')

        // Pagination
        if totalPages > 1
          .bg-white.px-6.py-4.border-t.border-gray-200
            .flex.justify-between.items-center
              .text-sm.text-gray-700 
                | Strona #{currentPage} z #{totalPages} (#{totalCount} wpisów)
              
              .flex.space-x-2
                if currentPage > 1
                  a(href=`?page=${currentPage - 1}${search ? '&search=' + encodeURIComponent(search) : ''}`).px-3.py-2.bg-gray-200.text-gray-700.rounded.hover:bg-gray-300
                    | ← Poprzednia
                
                // Page numbers
                - var startPage = Math.max(1, currentPage - 2)
                - var endPage = Math.min(totalPages, currentPage + 2)
                
                each pageNum in Array.from({length: endPage - startPage + 1}, (_, i) => startPage + i)
                  if pageNum === currentPage
                    span.px-3.py-2.bg-green-600.text-white.rounded= pageNum
                  else
                    a(href=`?page=${pageNum}${search ? '&search=' + encodeURIComponent(search) : ''}`).px-3.py-2.bg-gray-200.text-gray-700.rounded.hover:bg-gray-300= pageNum
                
                if currentPage < totalPages
                  a(href=`?page=${currentPage + 1}${search ? '&search=' + encodeURIComponent(search) : ''}`).px-3.py-2.bg-gray-200.text-gray-700.rounded.hover:bg-gray-300
                    | Następna →

      else
        // Empty State
        .bg-white.rounded-lg.shadow-md.p-12.text-center
          .text-gray-400.text-6xl.mb-4 📚
          h3.text-xl.font-semibold.text-gray-700.mb-2 Brak zatwierdzonych wpisów
          p.text-gray-500.mb-6 
            if search 
              | Nie znaleziono wpisów pasujących do wyszukiwania "#{search}"
            else
              | Nie ma jeszcze żadnych zatwierdzonych książek w słowniku.
          
          .space-x-4
            if search
              a(href="/admin/book-dictionary/approved").bg-blue-600.hover:bg-blue-700.text-white.px-6.py-2.rounded-md
                | 🔄 Pokaż wszystkie
            a(href="/admin/book-dictionary/import").bg-green-600.hover:bg-green-700.text-white.px-6.py-2.rounded-md
              | 📤 Importuj nowe książki

      // Usage Instructions
      .bg-white.rounded-lg.shadow-md.p-6.mt-8
        h2.text-xl.font-semibold.text-gray-800.mb-4 📖 Jak korzystać ze słownika
        .grid.md:grid-cols-2.gap-6
          div
            h3.font-semibold.text-blue-800.mb-2 🔍 API Wyszukiwania
            .text-sm.text-gray-600.space-y-1
              p <strong>Endpoint:</strong> <code class="bg-gray-100 px-1 rounded">/api/book-dictionary/search</code>
              p <strong>Parametr:</strong> <code class="bg-gray-100 px-1 rounded">?q=fraza_wyszukiwania</code>
              p <strong>Limit:</strong> <code class="bg-gray-100 px-1 rounded">?limit=10</code> (domyślnie 10)
              p <strong>Zwraca:</strong> JSON z wynikami książek ze słownika
          
          div
            h3.font-semibold.text-green-800.mb-2 💡 Integracja
            .text-sm.text-gray-600.space-y-1
              p Słownik można wykorzystać do:
              p • Automatycznego wypełniania danych książek
              p • Podpowiedzi cen przy dodawaniu ogłoszeń
              p • Walidacji danych wprowadzanych przez użytkowników
              p • Tworzenia katalogu dostępnych podręczników

block scripts
  script.
    // API Search Test Function
    async function testSearchApi() {
      const query = document.getElementById('searchApi').value;
      const resultsContainer = document.getElementById('searchResults');
      const apiContainer = document.getElementById('apiResultsContainer');
      
      if (!query || query.length < 2) {
        alert('⚠️ Wprowadź przynajmniej 2 znaki do wyszukania');
        return;
      }
      
      try {
        const response = await fetch(`/api/book-dictionary/search?q=${encodeURIComponent(query)}&limit=5`);
        const data = await response.json();
        
        resultsContainer.classList.remove('hidden');
        
        if (data.results && data.results.length > 0) {
          apiContainer.innerHTML = data.results.map(book => `
            <div class="border-b border-gray-200 py-2 last:border-b-0">
              <div class="font-semibold text-sm">${book.title}</div>
              <div class="text-xs text-gray-600">
                📖 ${book.publisher} (${book.year}) | 👥 ${book.authors}
              </div>
              <div class="text-xs text-blue-600">
                💰 Nowa: ${book.newPrice}zł | Używana: ${book.usedPrice}zł | 📚 ISBN: ${book.isbn}
              </div>
            </div>
          `).join('');
        } else {
          apiContainer.innerHTML = '<div class="text-gray-500 text-sm">🔍 Brak wyników dla "' + query + '"</div>';
        }
      } catch (error) {
        console.error('API Error:', error);
        resultsContainer.classList.remove('hidden');
        apiContainer.innerHTML = '<div class="text-red-500 text-sm">❌ Błąd API: ' + error.message + '</div>';
      }
    }
    
    // Enter key support for API search
    document.getElementById('searchApi').addEventListener('keypress', function(e) {
      if (e.key === 'Enter') {
        e.preventDefault();
        testSearchApi();
      }
    });
