    "express-rate-limit": "^7.1.5",
    "mongoose": "^8.0.3",
    "mongoose-paginate-v2": "^1.7.4",
    "bcryptjs": "^2.4.3",
    "jsonwebtoken": "^9.0.2",
    "passport": "^0.7.0",
    "passport-local": "^1.0.0",
