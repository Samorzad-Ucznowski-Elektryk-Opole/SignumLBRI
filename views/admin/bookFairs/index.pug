extends ../admin/layout

block title
  title Book Fair Management - SignumLBRI Admin

block content
  .bg-white rounded-lg shadow-lg p-6
    .flex justify-between items-center mb-6
      h1.text-3xl.font-bold.text-gray-800 Book Fair Management
      a.bg-indigo-600.hover:bg-indigo-700.text-white.font-medium.py-2.px-4.rounded-lg.transition-colors(href="/admin/book-fairs/create")
        | + Create New Book Fair

    // Stats Overview
    if stats
      .grid.grid-cols-1.md:grid-cols-4.gap-6.mb-8
        .bg-gradient-to-r.from-blue-500.to-blue-600.rounded-lg.p-6.text-white
          .flex.items-center.justify-between
            div
              h3.text-lg.font-medium Total Book Fairs
              p.text-3xl.font-bold= stats.total || 0
            i.fas.fa-calendar-alt.text-2xl.opacity-80
        
        .bg-gradient-to-r.from-green-500.to-green-600.rounded-lg.p-6.text-white
          .flex.items-center.justify-between
            div
              h3.text-lg.font-medium Active Fairs
              p.text-3xl.font-bold= stats.active || 0
            i.fas.fa-play-circle.text-2xl.opacity-80
        
        .bg-gradient-to-r.from-yellow-500.to-yellow-600.rounded-lg.p-6.text-white
          .flex.items-center.justify-between
            div
              h3.text-lg.font-medium Total Exhibitors
              p.text-3xl.font-bold= stats.exhibitors || 0
            i.fas.fa-store.text-2xl.opacity-80
        
        .bg-gradient-to-r.from-purple-500.to-purple-600.rounded-lg.p-6.text-white
          .flex.items-center.justify-between
            div
              h3.text-lg.font-medium Total Events
              p.text-3xl.font-bold= stats.events || 0
            i.fas.fa-calendar-check.text-2xl.opacity-80

    // Filters
    .bg-gray-50.rounded-lg.p-4.mb-6
      .flex.flex-wrap.gap-4.items-center
        div
          label.block.text-sm.font-medium.text-gray-700.mb-1 Status
          select#statusFilter.border.border-gray-300.rounded-md.px-3.py-2.bg-white
            option(value="") All Statuses
            option(value="planning") Planning
            option(value="registration") Registration
            option(value="active") Active
            option(value="completed") Completed
            option(value="cancelled") Cancelled
        
        div
          label.block.text-sm.font-medium.text-gray-700.mb-1 Date Range
          select#dateFilter.border.border-gray-300.rounded-md.px-3.py-2.bg-white
            option(value="") All Dates
            option(value="upcoming") Upcoming
            option(value="current") Current Month
            option(value="past") Past Events
        
        button#applyFilters.bg-indigo-600.hover:bg-indigo-700.text-white.px-4.py-2.rounded-md.transition-colors
          | Apply Filters

    // Book Fairs List
    .bg-white.rounded-lg.shadow.overflow-hidden
      if bookFairs && bookFairs.length > 0
        .overflow-x-auto
          table.min-w-full.divide-y.divide-gray-200
            thead.bg-gray-50
              tr
                th.px-6.py-3.text-left.text-xs.font-medium.text-gray-500.uppercase.tracking-wider Name
                th.px-6.py-3.text-left.text-xs.font-medium.text-gray-500.uppercase.tracking-wider Dates
                th.px-6.py-3.text-left.text-xs.font-medium.text-gray-500.uppercase.tracking-wider Location
                th.px-6.py-3.text-left.text-xs.font-medium.text-gray-500.uppercase.tracking-wider Status
                th.px-6.py-3.text-left.text-xs.font-medium.text-gray-500.uppercase.tracking-wider Exhibitors
                th.px-6.py-3.text-left.text-xs.font-medium.text-gray-500.uppercase.tracking-wider Actions
            tbody.bg-white.divide-y.divide-gray-200
              each fair in bookFairs
                tr.hover:bg-gray-50
                  td.px-6.py-4
                    .flex.flex-col
                      span.text-sm.font-medium.text-gray-900= fair.name
                      span.text-sm.text-gray-500= fair.theme || 'No theme'
                  td.px-6.py-4
                    .flex.flex-col
                      span.text-sm.text-gray-900= moment(fair.startDate).format('MMM D, YYYY')
                      span.text-sm.text-gray-500= moment(fair.endDate).format('MMM D, YYYY')
                  td.px-6.py-4
                    .flex.flex-col
                      span.text-sm.text-gray-900= fair.location
                      if fair.venue
                        span.text-sm.text-gray-500= fair.venue
                  td.px-6.py-4
                    span.inline-flex.items-center.px-2.5.py-0.5.rounded-full.text-xs.font-medium(
                      class=fair.status === 'active' ? 'bg-green-100 text-green-800' : 
                            fair.status === 'planning' ? 'bg-blue-100 text-blue-800' :
                            fair.status === 'registration' ? 'bg-yellow-100 text-yellow-800' :
                            fair.status === 'completed' ? 'bg-gray-100 text-gray-800' :
                            'bg-red-100 text-red-800'
                    )= fair.status.toUpperCase()
                  td.px-6.py-4.text-sm.text-gray-900
                    = fair.stats ? fair.stats.exhibitorsCount : 0
                  td.px-6.py-4.text-sm.font-medium
                    .flex.space-x-2
                      a.text-indigo-600.hover:text-indigo-900.transition-colors(href=`/admin/book-fairs/${fair._id}`)
                        | View
                      a.text-yellow-600.hover:text-yellow-900.transition-colors(href=`/admin/book-fairs/${fair._id}/edit`)
                        | Edit
                      a.text-green-600.hover:text-green-900.transition-colors(href=`/admin/book-fairs/${fair._id}/dashboard`)
                        | Dashboard
      else
        .text-center.py-12
          i.fas.fa-calendar-times.text-4xl.text-gray-400.mb-4
          h3.text-lg.font-medium.text-gray-900.mb-2 No Book Fairs Found
          p.text-gray-500.mb-4 Get started by creating your first book fair.
          a.bg-indigo-600.hover:bg-indigo-700.text-white.font-medium.py-2.px-4.rounded-lg.transition-colors(href="/admin/book-fairs/create")
            | Create Book Fair

block scripts
  script.
    document.addEventListener('DOMContentLoaded', function() {
      const statusFilter = document.getElementById('statusFilter');
      const dateFilter = document.getElementById('dateFilter');
      const applyFilters = document.getElementById('applyFilters');
      
      applyFilters?.addEventListener('click', function() {
        const status = statusFilter?.value || '';
        const date = dateFilter?.value || '';
        
        const params = new URLSearchParams();
        if (status) params.append('status', status);
        if (date) params.append('date', date);
        
        window.location.href = `/admin/book-fairs?${params.toString()}`;
      });
    });
