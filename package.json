{
  "name": "signumlbri-enhanced",
  "version": "1.0.0",
  "description": "Modern school book management system with glassmorphism UI",
  "main": "enhanced-app.js",
  "scripts": {
    "start": "node enhanced-app.js",
    "dev": "nodemon enhanced-app.js",
    "test": "jest",
    "docker:build": "docker build -t signumlbri-enhanced .",
    "docker:run": "docker run -p 4000:4000 signumlbri-enhanced",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:logs": "docker-compose logs -f",
    "docker:restart": "docker-compose restart"
  },
  "keywords": [
    "education",
    "books",
    "management",
    "library",
    "school",
    "glassmorphism",
    "modern-ui"
  ],
  "author": "ZSEL SignumLBRI Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Samorzad-Ucznowski-Elektryk-Opole/SignumLBRI.git"
  },
  "dependencies": {
    "express": "^4.18.2",
    "express-session": "^1.17.3",
    "express-flash": "^0.0.2",
    "body-parser": "^1.20.2",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "helmet": "^7.1.0",
    "compression": "^1.7.4",
    "express-rate-limit": "^7.1.5",
    "mongoose": "^8.0.3",
    "bcryptjs": "^2.4.3",
    "jsonwebtoken": "^9.0.2",
    "passport": "^0.7.0",
    "passport-local": "^1.0.0",
    "passport-jwt": "^4.0.1",
    "dotenv": "^16.3.1",
    "multer": "^1.4.5-lts.1",
    "sharp": "^0.33.0",
    "validator": "^13.11.0",
    "winston": "^3.11.0",
    "node-cron": "^3.0.3",
    "nodemailer": "^6.9.7",
    "qrcode": "^1.5.3",
    "pdf-lib": "^1.17.1",
    "csv-parser": "^3.0.0",
    "csv-writer": "^1.6.0",
    "moment": "^2.29.4",
    "lodash": "^4.17.21",
    "chalk": "^4.1.2",
    "morgan": "^1.10.0",
    "express-validator": "^7.0.1",
    "pug": "^3.0.2"
