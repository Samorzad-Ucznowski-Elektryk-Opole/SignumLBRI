{
  "name": "signumlbri-enhanced",
  "version": "1.0.0",
  "description": "Modern school book management system with glassmorphism UI",
  "main": "dist/server.js",
  "scripts": {
    "start": "node dist/server.js",
    "dev": "nodemon --exec ts-node src/server.ts",
    "build": "tsc",
    "build:watch": "tsc -w",
    "test": "jest",
    "lint": "eslint src/**/*.ts",
    "clean": "rimraf dist",
    "docker:build": "docker build -t signumlbri-enhanced .",
    "docker:run": "docker run -p 4000:4000 signumlbri-enhanced",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:logs": "docker-compose logs -f",
    "docker:restart": "docker-compose restart",
    "debug:enhanced": "node temp/enhanced-app-debug.js"
  },
  "keywords": [
    "education",
    "books",
    "management",
    "library",
    "school",
    "glassmorphism",
    "modern-ui"
  ],
  "author": "ZSEL SignumLBRI Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Samorzad-Ucznowski-Elektryk-Opole/SignumLBRI.git"
  },
  "dependencies": {
