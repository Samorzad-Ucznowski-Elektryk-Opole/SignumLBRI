extends ../layout
include ../../mixins/a

block content
  .admin-container.p-6
    .header-section.mb-8
      +a("/admin/bookfair", "btn btn-outline-secondary btn-sm mb-4")
        | ← Powrót do listy
      
      h1.text-3xl.font-bold.text-gray-800.mb-2 Utwórz nowe targi książki
      p.text-gray-600 Wypełnij formularz, aby utworzyć nowe wydarzenie targowe

    .content-section
      .max-w-3xl
        form(method="post", action="/admin/bookfair/create").bg-white.rounded-lg.shadow-md.p-6
          
          .form-section.mb-8
            h2.text-xl.font-semibold.text-gray-800.mb-4 Podstawowe informacje
            
            .grid.grid-cols-1.md:grid-cols-2.gap-6
              .form-group
                label.block.text-sm.font-medium.text-gray-700.mb-2(for="name") Nazwa targów *
                input.form-control(
                  type="text"
                  id="name"
                  name="name"
                  required
                  placeholder="np. Targi Książki Edukacyjnej 2025"
                )
              
              .form-group
                label.block.text-sm.font-medium.text-gray-700.mb-2(for="organizer") Organizator *
                input.form-control(
                  type="text"
                  id="organizer"
                  name="organizer"
                  required
                  placeholder="np. Zespół Szkół Ekonomicznych w Lublinie"
                )
            
            .form-group
              label.block.text-sm.font-medium.text-gray-700.mb-2(for="description") Opis targów
              textarea.form-control(
                id="description"
                name="description"
                rows="4"
                placeholder="Opisz charakter i cele targów książki..."
              )

          .form-section.mb-8
            h2.text-xl.font-semibold.text-gray-800.mb-4 Lokalizacja
            
            .grid.grid-cols-1.md:grid-cols-2.gap-6
              .form-group
                label.block.text-sm.font-medium.text-gray-700.mb-2(for="venue") Miejsce *
                input.form-control(
                  type="text"
                  id="venue"
                  name="location[venue]"
                  required
                  placeholder="np. Aula główna szkoły"
                )
              
              .form-group
                label.block.text-sm.font-medium.text-gray-700.mb-2(for="city") Miasto *
                input.form-control(
                  type="text"
                  id="city"
                  name="location[city]"
                  required
                  placeholder="np. Lublin"
                  value="Lublin"
                )
            
            .form-group
              label.block.text-sm.font-medium.text-gray-700.mb-2(for="address") Adres
              input.form-control(
                type="text"
                id="address"
                name="location[address]"
                placeholder="np. ul. Nadbystrzycka 84"
              )

          .form-section.mb-8
            h2.text-xl.font-semibold.text-gray-800.mb-4 Terminy
            
            .grid.grid-cols-1.md:grid-cols-2.gap-6
              .form-group
                label.block.text-sm.font-medium.text-gray-700.mb-2(for="startDate") Data rozpoczęcia *
                input.form-control(
                  type="datetime-local"
                  id="startDate"
                  name="startDate"
                  required
                )
              
              .form-group
                label.block.text-sm.font-medium.text-gray-700.mb-2(for="endDate") Data zakończenia *
                input.form-control(
                  type="datetime-local"
                  id="endDate"
                  name="endDate"
                  required
                )

          .form-section.mb-8
            h2.text-xl.font-semibold.text-gray-800.mb-4 Konfiguracja stoisk
            
            .grid.grid-cols-1.md:grid-cols-2.gap-6
              .form-group
                label.block.text-sm.font-medium.text-gray-700.mb-2(for="totalBooths") Liczba stoisk *
                input.form-control(
                  type="number"
                  id="totalBooths"
                  name="totalBooths"
                  required
                  min="1"
                  max="100"
                  placeholder="10"
                  value="10"
                )
              
              .form-group
                label.block.text-sm.font-medium.text-gray-700.mb-2(for="boothPrice") Cena stoiska (PLN)
                input.form-control(
                  type="number"
                  id="boothPrice"
                  name="boothPrice"
                  min="0"
                  step="0.01"
                  placeholder="500.00"
                  value="0"
                )

          .form-actions.flex.justify-end.gap-4.pt-6.border-t
            +a("/admin/bookfair", "btn btn-outline-secondary")
              | Anuluj
            
            button.btn.btn-primary(type="submit")
              | 📚 Utwórz targi

  script.
    // Set minimum date to today
    document.addEventListener('DOMContentLoaded', function() {
      const now = new Date();
      const startDateInput = document.getElementById('startDate');
      const endDateInput = document.getElementById('endDate');
      
      // Set minimum date to current date/time
      const isoString = now.toISOString().slice(0, 16);
      startDateInput.min = isoString;
      endDateInput.min = isoString;
      
      // Update end date minimum when start date changes
      startDateInput.addEventListener('change', function() {
        endDateInput.min = this.value;
        if (endDateInput.value && endDateInput.value < this.value) {
          endDateInput.value = this.value;
        }
      });
      
      // Validate that end date is after start date
      endDateInput.addEventListener('change', function() {
        if (startDateInput.value && this.value < startDateInput.value) {
          alert('Data zakończenia musi być późniejsza niż data rozpoczęcia');
          this.value = startDateInput.value;
        }
      });
    });
