block additional_scripts
  script.
    document.addEventListener('DOMContentLoaded', function() {
      // Initialize categories chart
      initCategoriesChart();
      
      // Initialize dashboard animations
      initDashboardAnimations();
      
      // Initialize tooltips
      const tooltips = document.querySelectorAll('[data-bs-toggle="tooltip"]');
      tooltips.forEach(tooltip => {
        new bootstrap.Tooltip(tooltip);
      });
    });
    
    function initCategoriesChart() {
      const ctx = document.getElementById('categoriesChart');
      if (!ctx) return;
      
      const categories = !{JSON.stringify(data.popularCategories || [])};
      
      new Chart(ctx, {
        type: 'doughnut',
        data: {
          labels: categories.map(cat => cat._id || '#{lang === "pl" ? "Bez kategorii" : lang === "uk" ? "Без категорії" : "Uncategorized"}'),
          datasets: [{
            data: categories.map(cat => cat.count),
            backgroundColor: [
              'rgba(99, 102, 241, 0.8)',
              'rgba(16, 185, 129, 0.8)',
              'rgba(245, 158, 11, 0.8)',
              'rgba(239, 68, 68, 0.8)',
              'rgba(139, 92, 246, 0.8)',
              'rgba(6, 182, 212, 0.8)',
              'rgba(236, 72, 153, 0.8)',
              'rgba(34, 197, 94, 0.8)'
            ],
            borderWidth: 0
          }]
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          plugins: {
            legend: {
              display: false
            }
          },
          animation: {
            animateRotate: true,
            duration: 1500
          }
        }
      });
    }
    
    function initDashboardAnimations() {
      // Animate statistics counters
      const statNumbers = document.querySelectorAll('.stat-number');
      
      statNumbers.forEach(element => {
        const finalValue = parseInt(element.textContent.replace(/[^\d]/g, ''));
        if (isNaN(finalValue)) return;
        
        animateCounter(element, finalValue, 2000);
      });
      
      // Animate category bars
      setTimeout(() => {
        const categoryBars = document.querySelectorAll('.bar-fill');
        categoryBars.forEach(bar => {
          const width = bar.style.width;
          bar.style.width = '0%';
          setTimeout(() => {
            bar.style.transition = 'width 1.5s ease-out';
            bar.style.width = width;
          }, 100);
        });
      }, 500);
    }
    
    function animateCounter(element, target, duration) {
      const start = 0;
      const startTime = performance.now();
      const originalText = element.textContent;
      const suffix = originalText.replace(/[\d,]/g, '');
      
      function update(currentTime) {
        const elapsed = currentTime - startTime;
        const progress = Math.min(elapsed / duration, 1);
        const current = Math.floor(start + (target - start) * progress);
        
        element.textContent = current.toLocaleString() + suffix;
        
        if (progress < 1) {
          requestAnimationFrame(update);
        }
      }
      
      requestAnimationFrame(update);
    }
