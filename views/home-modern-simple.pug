extends layout_tailwindcss

block content
  .container.mx-auto.px-4.py-16
    .text-center.mb-12
      h1.text-4xl.font-bold.mb-4
        | SignumLBRI - Modern UI Preview
      p.text-xl.text-gray-600
        | Demonstracja modern UI z efektami glassmorphism
    
    .grid.gap-8.max-w-4xl.mx-auto
      // Simple Glass Card
      .glass-card.p-8.text-center
        .w-16.h-16.bg-blue-500.rounded-full.flex.items-center.justify-center.mb-4.mx-auto
          svg.w-8.h-8.text-white(fill="none" stroke="currentColor" viewBox="0 0 24 24")
            path(stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.746 0 3.332.477 4.5 1.253v13C19.832 18.477 18.246 18 16.5 18c-1.746 0-3.332.477-4.5 1.253")
        h3.text-xl.font-bold.text-gray-900.mb-3
          | Glassmorphism Card
        p.text-gray-700.mb-4
          | Ta karta wykorzystuje efekt glassmorphism z transparent backgroundem i backdrop-blur.
        a.inline-flex.items-center.px-6.py-3.bg-blue-500.text-white.rounded-lg.font-semibold.transition-colors.duration-300(href="/library")
          | Sprawdź Bibliotekę
          svg.ml-2.w-4.h-4(fill="none" stroke="currentColor" viewBox="0 0 24 24")
            path(stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7")
      
      // Another Glass Card
      .glass-card.p-8.text-center
        .w-16.h-16.bg-green-500.rounded-full.flex.items-center.justify-center.mb-4.mx-auto
          svg.w-8.h-8.text-white(fill="none" stroke="currentColor" viewBox="0 0 24 24")
            path(stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z")
        h3.text-xl.font-bold.text-gray-900.mb-3
          | Modern Design
        p.text-gray-700.mb-4
          | Wszystkie komponenty używają najnowszych standardów designu 2025 z czystą typografią Inter.
        a.inline-flex.items-center.px-6.py-3.bg-green-500.text-white.rounded-lg.font-semibold.transition-colors.duration-300(href="/login")
          | Zaloguj się
          svg.ml-2.w-4.h-4(fill="none" stroke="currentColor" viewBox="0 0 24 24")
            path(stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7")
      
      // Third Glass Card  
      .glass-card.p-8.text-center
        .w-16.h-16.bg-purple-500.rounded-full.flex.items-center.justify-center.mb-4.mx-auto
          svg.w-8.h-8.text-white(fill="none" stroke="currentColor" viewBox="0 0 24 24")
            path(stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z")
        h3.text-xl.font-bold.text-gray-900.mb-3
          | Szybkie Działanie
        p.text-gray-700.mb-4
          | Platforma działa płynnie dzięki zoptymalizowanym stylom CSS i nowoczesnej architekturze.
        a.inline-flex.items-center.px-6.py-3.bg-purple-500.text-white.rounded-lg.font-semibold.transition-colors.duration-300(href="#")
          | Więcej Info
          svg.ml-2.w-4.h-4(fill="none" stroke="currentColor" viewBox="0 0 24 24")
            path(stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7")
    
    .text-center.mt-16
      h2.text-2xl.font-bold.mb-4
        | Modern UI Features
      .glass-modern.p-6.max-w-2xl.mx-auto
        ul.space-y-2.text-left
          li.flex.items-center
            svg.w-5.h-5.text-green-500.mr-3(fill="currentColor" viewBox="0 0 20 20")
              path(fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd")
            | Glassmorphism effects z backdrop-filter blur
          li.flex.items-center
            svg.w-5.h-5.text-green-500.mr-3(fill="currentColor" viewBox="0 0 20 20")
              path(fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd")
            | Inter font family z font-feature-settings
          li.flex.items-center
            svg.w-5.h-5.text-green-500.mr-3(fill="currentColor" viewBox="0 0 20 20")
              path(fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd")
            | CSS custom properties (variables) dla design system  
          li.flex.items-center
            svg.w-5.h-5.text-green-500.mr-3(fill="currentColor" viewBox="0 0 20 20")
              path(fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd")
            | Smooth transitions i hover effects
          li.flex.items-center
            svg.w-5.h-5.text-green-500.mr-3(fill="currentColor" viewBox="0 0 20 20")
              path(fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd")
            | Responsywny design z mobile-first approach
