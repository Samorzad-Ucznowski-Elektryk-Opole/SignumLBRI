doctype html
html(lang='')
  head
    meta(charset='utf-8')
    meta(http-equiv='X-UA-Compatible', content='IE=edge')
    meta(name='viewport', content='width=device-width, initial-scale=1.0')
    title #{title} - SignumLBRI
    meta(name='description', content='')
    meta(name='theme-color' content='#4DA5F4')
    link(rel='stylesheet', href=`/css/tailwind.${version}.css`)
    link(rel='stylesheet', href='/css/modern-ui.css')
    if (title && title.includes && title.includes('Library')) || (typeof isLandingPage !== 'undefined' && isLandingPage)
      link(rel='stylesheet', href='/css/landing.css')
  body.bg-back-blue.using-tailwindcss.p-2.flex.flex-col.min-h-screen
    include partials/flash_tailwindcss
    if !disableLogin
      include partials/header_tailwindcss
    block content
    include partials/footer_tailwindcss
    script(defer, src=`/js/main.${version}.js`)
  