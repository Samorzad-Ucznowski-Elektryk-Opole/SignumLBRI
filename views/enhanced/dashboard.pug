                      .activity-time= lang === 'pl' ? '5 minut temu' : lang === 'uk' ? '5 хвилин тому' : '5 minutes ago'
                  
                  .activity-item
                    .activity-icon
                      i.fas.fa-user.text-success
                    .activity-content
                      .activity-text= lang === 'pl' ? 'Nowy użytkownik dołączył do systemu' : lang === 'uk' ? 'Новий користувач приєднався до системи' : 'New user joined the system'
                      .activity-time= lang === 'pl' ? '12 minut temu' : lang === 'uk' ? '12 хвилин тому' : '12 minutes ago'
                  
