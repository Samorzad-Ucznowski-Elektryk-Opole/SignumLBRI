doctype html
html(lang='pl')
  head
    meta(charset='utf-8')
    meta(http-equiv='X-UA-Compatible', content='IE=edge')
    meta(name='viewport', content='width=device-width, initial-scale=1.0')
    title #{title} - SignumLBRI Public
    meta(name='description', content='Publiczne statystyki targów książkowych - transparentność i otwarte dane')
    meta(name='theme-color' content='#4DA5F4')
    
    // Bootstrap CSS
    link(href='https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css', rel='stylesheet')
    // Chart.js
    script(src='https://cdn.jsdelivr.net/npm/chart.js')
    // Custom CSS
    style.
      .hero-section {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: white;
        padding: 80px 0;
      }
      .stats-card {
        border: none;
        border-radius: 15px;
        box-shadow: 0 4px 6px rgba(0,0,0,0.1);
        transition: transform 0.3s;
      }
      .stats-card:hover {
        transform: translateY(-5px);
      }
      .stat-value {
        font-size: 2.5rem;
        font-weight: 700;
        color: #667eea;
      }
      .chart-container {
        position: relative;
        height: 400px;
      }
      .footer {
        background: #2c3e50;
        color: white;
        padding: 40px 0;
      }
      .last-update {
        color: #6c757d;
        font-size: 0.9rem;
      }

  body
    // Navigation
    nav.navbar.navbar-expand-lg.navbar-dark.bg-dark
      .container
        a.navbar-brand(href='/public') 
          strong SignumLBRI 
          small.text-muted Public
        
        button.navbar-toggler(type='button', data-bs-toggle='collapse', data-bs-target='#navbarNav')
          span.navbar-toggler-icon
        
        .collapse.navbar-collapse#navbarNav
          .navbar-nav.ms-auto
            a.nav-link(href='/public') Dashboard
            a.nav-link(href='/public/api/opendata') Open Data API
            a.nav-link(href='/') Logowanie
    
    block content
    
    // Footer
    footer.footer
      .container
        .row
          .col-md-6
            h5 O Transparentności
            p Publiczny dostęp do statystyk targów książkowych w szkołach. Wszystkie dane są anonimizowane zgodnie z RODO.
            
          .col-md-3
            h5 Open Data
            ul.list-unstyled
              li: a.text-light(href='/public/api/opendata') JSON API
              li: a.text-light(href='/public/api/opendata?format=csv') CSV Export  
              li: a.text-light(href='/public/api/opendata?format=xml') XML Export
              
          .col-md-3
            h5 Informacje
            ul.list-unstyled
              li: small Aktualizacja: #{lastUpdate.toLocaleString('pl-PL')}
              li: small System: SignumLBRI v#{version || '0.1.0'}
              li: small Licencja: MIT
        
        hr.my-4
        .text-center
          small &copy; 2025 SignumLBRI - Publiczne dane targów książkowych
    
    // Bootstrap JS
    script(src='https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js')
