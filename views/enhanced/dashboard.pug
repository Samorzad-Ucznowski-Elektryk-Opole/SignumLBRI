                    .status-name= lang === 'pl' ? 'Serwer' : lang === 'uk' ? 'Сервер' : 'Server'
                    .status-value= lang === 'pl' ? 'Online' : lang === 'uk' ? 'Онлайн' : 'Online'
                
                .status-item
                  .status-indicator.status-online
                  .status-info
                    .status-name= lang === 'pl' ? 'Baza danych' : lang === 'uk' ? 'База даних' : 'Database'
                    .status-value= lang === 'pl' ? 'Połączono' : lang === 'uk' ? 'З\'єднано' : 'Connected'
                
                .status-item
                  .status-indicator.status-warning
                  .status-info
                    .status-name= lang === 'pl' ? 'Wykorzystanie' : lang === 'uk' ? 'Використання' : 'Usage'
